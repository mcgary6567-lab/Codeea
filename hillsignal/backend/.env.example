# Copy to .env for local development. In production, set these as real environment variables.
NODE_ENV=development
PORT=4000
APP_NAME=HillSignal
DATABASE_URL=postgres://hillsignal:hillsignal@localhost:5432/hillsignal
# openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=*

# Claude API key from https://console.anthropic.com. Leave empty to turn AI features off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

FREE_DELAY_DAYS=3
FREE_HISTORY_DAYS=365

# Google Play: service account JSON key (the file contents) with access to orders/subscriptions
GOOGLE_PLAY_PACKAGE_NAME=com.hillsignal.app
GOOGLE_SERVICE_ACCOUNT_JSON=
# Pub/Sub push auth for Real-time Developer Notifications: OIDC audience (preferred) or a shared secret
RTDN_PUSH_AUDIENCE=
RTDN_SHARED_SECRET=

# 0 = off (run `npm run ingest -- all` from cron instead). 60 = hourly inside the API process.
INGEST_INTERVAL_MINUTES=0

# Optional: Expo access token if you enabled "enhanced push security"
EXPO_ACCESS_TOKEN=
