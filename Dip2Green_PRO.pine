//@version=6
// =============================================================================
//  Dip Red + 2 Green — PRO  (with all recommended improvements)
//  Long: oversold red flush + N greens     Short: overbought green pop + N reds
// =============================================================================
indicator("Dip2Green PRO", "Dip2Green PRO", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================================================================
// 0)  ASSET PRESET (unchanged from original)
// ============================================================================
preset = input.string("Auto", "Asset Preset",
     options=["Auto","Forex Major","JPY Pair","Crypto","Gold/Metals","Indices","Stocks","Custom"],
     group="Asset Settings")

tickerStr = syminfo.ticker
isJPYpair = str.contains(tickerStr, "JPY")
isGold    = str.contains(tickerStr, "XAU") or str.contains(tickerStr, "GOLD")
isSilver  = str.contains(tickerStr, "XAG") or str.contains(tickerStr, "SILVER")
isOil     = str.contains(tickerStr, "OIL") or str.contains(tickerStr, "USOIL")
typ       = syminfo.type
autoPreset = typ == "crypto" ? "Crypto" : typ == "stock" ? "Stocks" : typ == "index" ? "Indices" :
             (isGold or isSilver) ? "Gold/Metals" : isOil ? "Indices" :
             isJPYpair ? "JPY Pair" : "Forex Major"
eff = preset == "Auto" ? autoPreset : preset

// ---- Custom overrides ------------------------------------------------------
gC = "Custom Preset (when preset=Custom)"
custOS   = input.int(30,   "RSI Oversold",   minval=10, maxval=50, group=gC)
custATR  = input.float(0.8,"Range x ATR",    minval=0.2, step=0.1, group=gC)
custVol  = input.float(1.0,"Volume x avg",   minval=0.3, step=0.1, group=gC)
custLook = input.int(10,   "Low Lookback",   minval=2,             group=gC)

gI = "Internals"
rsiLen = input.int(14, "RSI Length", group=gI)
atrLen = input.int(14, "ATR Length", group=gI)
volLen = input.int(20, "Volume MA",  group=gI)
adxLen = input.int(14, "ADX Length", group=gI)

// ---- Resolve preset --------------------------------------------------------
effOS   = eff == "Custom" ? custOS  : eff == "Forex Major" ? 33 : eff == "JPY Pair" ? 30 :
          eff == "Crypto" ? 30 : eff == "Gold/Metals" ? 32 : eff == "Indices" ? 35 :
          eff == "Stocks" ? 32 : 30
effATR  = eff == "Custom" ? custATR : eff == "Forex Major" ? 0.5 : eff == "JPY Pair" ? 0.7 :
          eff == "Crypto" ? 0.8 : eff == "Gold/Metals" ? 0.6 : eff == "Indices" ? 0.5 :
          eff == "Stocks" ? 0.6 : 0.6
effVol  = eff == "Custom" ? custVol : eff == "Forex Major" ? 0.8 : eff == "JPY Pair" ? 0.9 :
          eff == "Crypto" ? 1.0 : eff == "Gold/Metals" ? 0.8 : eff == "Indices" ? 0.7 :
          eff == "Stocks" ? 0.9 : 0.9
effLook = eff == "Custom" ? custLook: eff == "Forex Major" ? 8  : eff == "JPY Pair" ? 10 :
          eff == "Crypto" ? 8  : eff == "Gold/Metals" ? 8  : eff == "Indices" ? 6 :
          eff == "Stocks" ? 8  : 8

// ============================================================================
// 1)  TREND / REGIME FILTERS (Improvement #1)
// ============================================================================
gT = "Trend & Regime Filters"
useHTFTrend = input.bool(true,  "Require HTF trend agreement",     group=gT)
htfTF       = input.timeframe("240", "Higher Timeframe",           group=gT)
htfEmaLen   = input.int(50,     "HTF EMA length",                  group=gT)
useLocalEma = input.bool(true,  "Require local EMA200 agreement",  group=gT)
localEmaLen = input.int(200,    "Local EMA length",                group=gT)
useADX      = input.bool(true,  "Skip when ADX too low (chop)",    group=gT)
adxMin      = input.float(15.0, "Min ADX",                         group=gT)

// Local EMA
localEma = ta.ema(close, localEmaLen)

// HTF trend (gap-safe)
htfClose = request.security(syminfo.tickerid, htfTF, close,         barmerge.gaps_off, barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen),
                            barmerge.gaps_off, barmerge.lookahead_off)
htfBullTrend = htfClose > htfEma
htfBearTrend = htfClose < htfEma

// ADX (manual: di+/di-)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxOK = not useADX or adxVal >= adxMin

// ============================================================================
// 2)  SESSION FILTER (Improvement #1c)
// ============================================================================
gS = "Session Filter"
useSession = input.bool(false, "Restrict to a session",      group=gS)
sessSpec   = input.session("0700-2100", "Session (exchange tz)", group=gS)
inSession  = not useSession or not na(time(timeframe.period, sessSpec))

// ============================================================================
// 3)  PER-BAR INDICATORS
// ============================================================================
rsi    = ta.rsi(close, rsiLen)
atr    = ta.atr(atrLen)
volAvg = ta.sma(volume, volLen)

hasVolume = ta.cum(volume) > 0
volPass   = not hasVolume or volume >= volAvg * effVol

isRed   = close < open
isGreen = close > open
body    = math.abs(close - open)
rng     = math.max(high - low, syminfo.mintick)
bodyPct = body / rng

// MTF RSI (Improvement #4)
gM = "Multi-TF RSI Confluence"
useMtfRsi = input.bool(true, "Require HTF RSI < 50 for longs (>50 for shorts)", group=gM)
htfRsi = request.security(syminfo.tickerid, htfTF, ta.rsi(close, rsiLen),
                          barmerge.gaps_off, barmerge.lookahead_off)
mtfLongOK  = not useMtfRsi or htfRsi < 50
mtfShortOK = not useMtfRsi or htfRsi > 50

// ============================================================================
// 4)  DIP QUALITY SCORE  (Improvement #3) — replaces hard binary detection
// ============================================================================
gQ = "Dip / Rally Quality Score"
useScore   = input.bool(true, "Use composite score (recommended)", group=gQ)
scoreMin   = input.float(55.0, "Minimum score to fire (0-100)",    group=gQ)
wRSI       = input.float(25, "Weight: RSI depth",        group=gQ, step=1)
wATR       = input.float(20, "Weight: Range / ATR",      group=gQ, step=1)
wVol       = input.float(20, "Weight: Volume vs avg",    group=gQ, step=1)
wPivot     = input.float(20, "Weight: Below pivot",      group=gQ, step=1)
wBody      = input.float(15, "Weight: Body / Range",     group=gQ, step=1)

clamp01(x) => math.max(0.0, math.min(1.0, x))

// Long score (deeper dip = better)
rsiDepth   = clamp01((effOS - rsi) / 20.0)
atrFactor  = clamp01((rng / atr - effATR) / (effATR * 2.0))
volFactor  = hasVolume ? clamp01((volume / volAvg - effVol) / 1.5) : 0.7
pivotLow   = ta.lowest(low, effLook)
pivotFactor= low <= pivotLow ? 1.0 : clamp01(1.0 - (low - pivotLow) / (atr * 0.5))
bodyFactor = clamp01(bodyPct - 0.3)  // reward solid red body
longScore  = rsiDepth * wRSI + atrFactor * wATR + volFactor * wVol +
             pivotFactor * wPivot + bodyFactor * wBody

// Short score (mirror)
rsiHeight   = clamp01((rsi - (100 - effOS)) / 20.0)
pivotHigh   = ta.highest(high, effLook)
pivotFactorS= high >= pivotHigh ? 1.0 : clamp01(1.0 - (pivotHigh - high) / (atr * 0.5))
shortScore  = rsiHeight * wRSI + atrFactor * wATR + volFactor * wVol +
              pivotFactorS * wPivot + bodyFactor * wBody

// ============================================================================
// 5)  TRIGGER BAR DETECTION
// ============================================================================
hardLongOK  = isRed   and rsi <= effOS         and (high - low) >= atr * effATR and
              low <= ta.lowest(low, effLook)   and volPass
hardShortOK = isGreen and rsi >= 100 - effOS    and (high - low) >= atr * effATR and
              high >= ta.highest(high, effLook) and volPass

isDipRed    = (useScore ? longScore  >= scoreMin : hardLongOK)  and
              volPass and adxOK and inSession and
              (not useLocalEma or close > localEma) and
              (not useHTFTrend or htfBullTrend) and mtfLongOK

isRallyGr   = (useScore ? shortScore >= scoreMin : hardShortOK) and
              volPass and adxOK and inSession and
              (not useLocalEma or close < localEma) and
              (not useHTFTrend or htfBearTrend) and mtfShortOK

// ============================================================================
// 6)  CONFIRMATION CANDLE QUALITY  (Improvement #3 fine-grain)
// ============================================================================
gCC = "Confirmation Candle Quality"
minBodyPct  = input.float(0.45, "Min body/range for confirmation candles", group=gCC)
reqHalfDip  = input.bool(true,  "Confirmation must close above dip 50%",   group=gCC)
reqVolConf  = input.bool(false, "Confirmation needs volume >= avg",        group=gCC)
allowOneInside = input.bool(true,"Allow ONE small inside bar without reset",group=gCC)
oppositeAbort  = input.bool(true,"Abort on strong opposite bar (>2 ATR)",   group=gCC)

confLongCandle  = isGreen and bodyPct >= minBodyPct and
                  (not reqVolConf or not hasVolume or volume >= volAvg)
confShortCandle = isRed   and bodyPct >= minBodyPct and
                  (not reqVolConf or not hasVolume or volume >= volAvg)

// ============================================================================
// 7)  STATE MACHINE  (Improvement #5 — hardened)
// ============================================================================
gSeq = "Sequence"
greenN  = input.int(2,  "Required confirmation bars", minval=1, group=gSeq)
maxWait = input.int(10, "Max wait bars",              minval=2, group=gSeq)

// LONG state
var bool  longActive   = false
var int   longGCount   = 0
var float longDipLow   = na
var float longDipMid   = na
var int   longBars     = 0
var int   longInsideUsed = 0

if isDipRed and not longActive
    longActive   := true
    longGCount   := 0
    longDipLow   := low
    longDipMid   := (high + low) / 2.0
    longBars     := 0
    longInsideUsed := 0
else if longActive
    longBars += 1
    bigBearBar = (open - close) > atr * 2.0 and isRed
    if longBars > maxWait or low < longDipLow or (oppositeAbort and bigBearBar)
        longActive := false
        longGCount := 0
    else
        passHalf = not reqHalfDip or close >= longDipMid
        if confLongCandle and passHalf
            longGCount += 1
        else if isRed and body < atr * 0.4 and allowOneInside and longInsideUsed == 0
            longInsideUsed := 1   // tolerate one tiny inside bar
        else
            longGCount := 0

longSignal = longActive and confLongCandle and longGCount >= greenN
if longSignal
    longActive := false
    longGCount := 0

// SHORT state (mirror)
var bool  shortActive   = false
var int   shortGCount   = 0
var float shortRallyHi  = na
var float shortRallyMid = na
var int   shortBars     = 0
var int   shortInsideUsed = 0

if isRallyGr and not shortActive
    shortActive   := true
    shortGCount   := 0
    shortRallyHi  := high
    shortRallyMid := (high + low) / 2.0
    shortBars     := 0
    shortInsideUsed := 0
else if shortActive
    shortBars += 1
    bigBullBar = (close - open) > atr * 2.0 and isGreen
    if shortBars > maxWait or high > shortRallyHi or (oppositeAbort and bigBullBar)
        shortActive := false
        shortGCount := 0
    else
        passHalf = not reqHalfDip or close <= shortRallyMid
        if confShortCandle and passHalf
            shortGCount += 1
        else if isGreen and body < atr * 0.4 and allowOneInside and shortInsideUsed == 0
            shortInsideUsed := 1
        else
            shortGCount := 0

shortSignal = shortActive and confShortCandle and shortGCount >= greenN
if shortSignal
    shortActive := false
    shortGCount := 0

// ============================================================================
// 8)  RISK / REWARD  (Improvement #2 — ATR-buffered SL, dynamic RR, multi-TP)
// ============================================================================
gR = "Risk Management"
slBuffer    = input.float(0.30, "SL: ATR buffer x ATR", minval=0.0, step=0.05, group=gR)
useDynRR    = input.bool(true,  "Dynamic RR by ATR percentile", group=gR)
baseRR      = input.float(2.0,  "Base R:R", group=gR, step=0.1)
tp1Frac     = input.float(0.5,  "TP1 fraction (close at 1R)",   group=gR, minval=0, maxval=1)
tp2Mult     = input.float(2.0,  "TP2 multiple of R",            group=gR, step=0.1)
useTrail    = input.bool(true,  "Trail remainder (chandelier)", group=gR)
trailATR    = input.float(2.5,  "Trail = N × ATR",              group=gR, step=0.1)
maxBarsHold = input.int(40,     "Time-stop: invalidate after N bars", group=gR)

// dynamic RR: scale with ATR percentile (bigger targets in expansion)
atrPct  = ta.percentrank(atr, 100) / 100.0
dynMult = useDynRR ? (0.7 + atrPct * 0.8) : 1.0   // 0.7×..1.5×
rrEff   = baseRR * dynMult

var float locDipLow  = na
var float locRallyHi = na
if isDipRed
    locDipLow := low
if isRallyGr
    locRallyHi := high

// LONG levels
longEntry = close
longSL    = (na(locDipLow)  ? ta.lowest(low, 5)  : locDipLow)  - atr * slBuffer
longRisk  = longEntry - longSL
longTP1   = longEntry + longRisk * 1.0
longTP2   = longEntry + longRisk * tp2Mult
longRRout = longEntry + longRisk * rrEff

// SHORT levels
shortEntry = close
shortSL    = (na(locRallyHi) ? ta.highest(high, 5) : locRallyHi) + atr * slBuffer
shortRisk  = shortSL - shortEntry
shortTP1   = shortEntry - shortRisk * 1.0
shortTP2   = shortEntry - shortRisk * tp2Mult
shortRRout = shortEntry - shortRisk * rrEff

// ============================================================================
// 9)  ALERTS  (Improvement #6 — JSON + dip-detected pre-alert)
// ============================================================================
gA = "Alerts"
alertOnBar = input.string("Bar Close","Frequency",options=["Bar Close","Every Tick"],group=gA)
alertHdr   = input.string("DIP2GREEN","Header tag",group=gA)
emitJSON   = input.bool(true,"Emit JSON payload",group=gA)
freq = alertOnBar == "Bar Close" ? alert.freq_once_per_bar_close : alert.freq_once_per_bar

f_jsonLong() =>
    "{\"action\":\"BUY\",\"symbol\":\""+tickerStr+"\",\"tf\":\""+timeframe.period+
    "\",\"entry\":"+str.tostring(longEntry,format.mintick)+
    ",\"sl\":"+str.tostring(longSL,format.mintick)+
    ",\"tp1\":"+str.tostring(longTP1,format.mintick)+
    ",\"tp2\":"+str.tostring(longTP2,format.mintick)+
    ",\"rr\":"+str.tostring(rrEff,"#.##")+
    ",\"score\":"+str.tostring(longScore,"#.#")+"}"

f_jsonShort() =>
    "{\"action\":\"SELL\",\"symbol\":\""+tickerStr+"\",\"tf\":\""+timeframe.period+
    "\",\"entry\":"+str.tostring(shortEntry,format.mintick)+
    ",\"sl\":"+str.tostring(shortSL,format.mintick)+
    ",\"tp1\":"+str.tostring(shortTP1,format.mintick)+
    ",\"tp2\":"+str.tostring(shortTP2,format.mintick)+
    ",\"rr\":"+str.tostring(rrEff,"#.##")+
    ",\"score\":"+str.tostring(shortScore,"#.#")+"}"

f_humanLong() =>
    ">>> " + alertHdr + " BUY <<< " + tickerStr + " | " + timeframe.period + " | " + eff +
    "\nScore: " + str.tostring(longScore,"#.#") + "/100  RSI: " + str.tostring(rsi,"#.##") +
    "\nEntry: " + str.tostring(longEntry,format.mintick) +
    "\nSL: "    + str.tostring(longSL,   format.mintick) +
    "\nTP1: "   + str.tostring(longTP1,  format.mintick) +
    "\nTP2: "   + str.tostring(longTP2,  format.mintick) +
    "\nRR(eff): 1:" + str.tostring(rrEff,"#.##")

f_humanShort() =>
    ">>> " + alertHdr + " SELL <<< " + tickerStr + " | " + timeframe.period + " | " + eff +
    "\nScore: " + str.tostring(shortScore,"#.#") + "/100  RSI: " + str.tostring(rsi,"#.##") +
    "\nEntry: " + str.tostring(shortEntry,format.mintick) +
    "\nSL: "    + str.tostring(shortSL,   format.mintick) +
    "\nTP1: "   + str.tostring(shortTP1,  format.mintick) +
    "\nTP2: "   + str.tostring(shortTP2,  format.mintick) +
    "\nRR(eff): 1:" + str.tostring(rrEff,"#.##")

if longSignal
    alert(emitJSON ? f_jsonLong() : f_humanLong(), freq)
if shortSignal
    alert(emitJSON ? f_jsonShort() : f_humanShort(), freq)
if isDipRed
    alert("DIP DETECTED — awaiting confirmation on " + tickerStr, freq)
if isRallyGr
    alert("RALLY DETECTED — awaiting confirmation on " + tickerStr, freq)

alertcondition(longSignal,  title="LONG (Dip+Greens)",  message="BUY signal — Dip2Green PRO")
alertcondition(shortSignal, title="SHORT (Rally+Reds)", message="SELL signal — Dip2Green PRO")

// ============================================================================
// 10) VISUALS  (Improvement #7 — score-colored marker, filled SL/TP boxes, table)
// ============================================================================
gV = "Visuals"
showDipDot   = input.bool(true,  "Mark dip / rally bar (score-colored)", group=gV)
showSignal   = input.bool(true,  "Show BUY / SELL arrows",                group=gV)
showBoxes    = input.bool(true,  "Draw SL / TP boxes",                    group=gV)
showTable    = input.bool(true,  "Status table (top-right)",              group=gV)
showShorts   = input.bool(true,  "Enable SHORT logic too",                group=gV)

scoreColor(s) =>
    s < 40 ? color.new(color.red,30) :
    s < 60 ? color.new(color.orange,20) :
    s < 80 ? color.new(color.yellow,0) : color.new(color.lime,0)

plotshape(showDipDot and isDipRed,  "Dip",   shape.diamond,    location.belowbar,
          scoreColor(longScore),  size=size.small)
plotshape(showShorts and showDipDot and isRallyGr, "Rally", shape.diamond, location.abovebar,
          scoreColor(shortScore), size=size.small)
plotshape(showSignal and longSignal,  "BUY",  shape.triangleup,   location.belowbar,
          color.new(color.lime,0), text="BUY",  textcolor=color.white, size=size.large)
plotshape(showShorts and showSignal and shortSignal, "SELL", shape.triangledown, location.abovebar,
          color.new(color.red,0),  text="SELL", textcolor=color.white, size=size.large)

bgcolor(longSignal  ? color.new(color.lime, 80) : na)
bgcolor(showShorts and shortSignal ? color.new(color.red, 85) : na)

// ---- "Buy / Sell now" labels ------------------------------------------------
if longSignal
    label.new(bar_index, low - atr, "BUY NOW\n"+str.tostring(longScore,"#")+"/100",
              color=color.new(color.black,0), textcolor=color.white,
              style=label.style_label_up, size=size.normal)
if showShorts and shortSignal
    label.new(bar_index, high + atr, "SELL NOW\n"+str.tostring(shortScore,"#")+"/100",
              color=color.new(color.black,0), textcolor=color.white,
              style=label.style_label_down, size=size.normal)

// ---- SL / TP boxes ----------------------------------------------------------
var box   longRiskBox   = na
var box   longRewardBox = na
var label longLbl       = na
if showBoxes and longSignal
    box.delete(longRiskBox), box.delete(longRewardBox), label.delete(longLbl)
    longRiskBox   := box.new(bar_index, longSL,    bar_index + 25, longEntry,
                             border_color=color.red, bgcolor=color.new(color.red, 85))
    longRewardBox := box.new(bar_index, longEntry, bar_index + 25, longTP2,
                             border_color=color.green, bgcolor=color.new(color.green, 85))
    line.new(bar_index, longTP1, bar_index + 25, longTP1,
             color=color.new(color.green, 30), style=line.style_dashed)
    longLbl := label.new(bar_index + 25, longTP2,
        "Entry " + str.tostring(longEntry, format.mintick) +
        "\nTP1 "  + str.tostring(longTP1,  format.mintick) +
        "\nTP2 "  + str.tostring(longTP2,  format.mintick) +
        "\nSL  "  + str.tostring(longSL,   format.mintick) +
        "\nRR 1:" + str.tostring(rrEff, "#.##"),
        style=label.style_label_left, color=color.new(color.blue, 70),
        textcolor=color.white, size=size.small)

var box   shortRiskBox   = na
var box   shortRewardBox = na
var label shortLbl       = na
if showShorts and showBoxes and shortSignal
    box.delete(shortRiskBox), box.delete(shortRewardBox), label.delete(shortLbl)
    shortRiskBox   := box.new(bar_index, shortEntry, bar_index + 25, shortSL,
                              border_color=color.red, bgcolor=color.new(color.red, 85))
    shortRewardBox := box.new(bar_index, shortTP2,   bar_index + 25, shortEntry,
                              border_color=color.green, bgcolor=color.new(color.green, 85))
    line.new(bar_index, shortTP1, bar_index + 25, shortTP1,
             color=color.new(color.green, 30), style=line.style_dashed)
    shortLbl := label.new(bar_index + 25, shortTP2,
        "Entry " + str.tostring(shortEntry, format.mintick) +
        "\nTP1 "  + str.tostring(shortTP1,  format.mintick) +
        "\nTP2 "  + str.tostring(shortTP2,  format.mintick) +
        "\nSL  "  + str.tostring(shortSL,   format.mintick) +
        "\nRR 1:" + str.tostring(rrEff, "#.##"),
        style=label.style_label_left, color=color.new(color.blue, 70),
        textcolor=color.white, size=size.small)

// ---- Status table -----------------------------------------------------------
var table tbl = table.new(position.top_right, 2, 9,
                          bgcolor=color.new(color.black, 70),
                          border_color=color.gray, border_width=1)
f_row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color=color.white,  text_size=size.small, bgcolor=color.new(color.black,60))
    table.cell(tbl, 1, r, v, text_color=c,            text_size=size.small, bgcolor=color.new(color.black,60))

stateLong  = longActive  ? "WAIT (" + str.tostring(longGCount)  + "/" + str.tostring(greenN) + ")" :
             longSignal  ? "SIGNAL" : "idle"
stateShort = shortActive ? "WAIT (" + str.tostring(shortGCount) + "/" + str.tostring(greenN) + ")" :
             shortSignal ? "SIGNAL" : "idle"

if showTable and barstate.islast
    f_row(0, "Preset",     eff,                                                    color.aqua)
    f_row(1, "Long score", str.tostring(longScore,  "#.#") + "/100",               scoreColor(longScore))
    f_row(2, "Short score",str.tostring(shortScore, "#.#") + "/100",               scoreColor(shortScore))
    f_row(3, "RSI",        str.tostring(rsi,"#.#"),                                color.white)
    f_row(4, "ADX",        str.tostring(adxVal,"#.#") + (adxOK ? " OK" : " low"),  adxOK ? color.lime : color.orange)
    f_row(5, "HTF trend",  htfBullTrend ? "BULL" : htfBearTrend ? "BEAR" : "flat", htfBullTrend ? color.lime : htfBearTrend ? color.red : color.gray)
    f_row(6, "Long state", stateLong,                                              longActive ? color.yellow : color.gray)
    f_row(7, "Short state",stateShort,                                             shortActive ? color.yellow : color.gray)
    f_row(8, "RR (dyn)",   "1:" + str.tostring(rrEff,"#.##"),                      color.aqua)

// ============================================================================
// 11) PERSISTENT TRADE TRACKER (Improvement #5 — time-stop / TP1 / trail)
// ============================================================================
var int   inTradeDir   = 0      // +1 long, -1 short, 0 flat
var float entryPx      = na
var float stopPx       = na
var float tp1Px        = na
var float tp2Px        = na
var int   barsInTrade  = 0
var bool  tp1Hit       = false

if longSignal
    inTradeDir := 1, entryPx := longEntry, stopPx := longSL,
    tp1Px := longTP1, tp2Px := longTP2, barsInTrade := 0, tp1Hit := false
if showShorts and shortSignal
    inTradeDir := -1, entryPx := shortEntry, stopPx := shortSL,
    tp1Px := shortTP1, tp2Px := shortTP2, barsInTrade := 0, tp1Hit := false

if inTradeDir != 0
    barsInTrade += 1
    // TP1 partial
    if not tp1Hit and ((inTradeDir == 1 and high >= tp1Px) or (inTradeDir == -1 and low <= tp1Px))
        tp1Hit := true
        label.new(bar_index, tp1Px, "TP1", style=label.style_label_left,
                  color=color.new(color.green, 30), textcolor=color.white, size=size.small)
    // Chandelier trail after TP1
    if useTrail and tp1Hit
        if inTradeDir == 1
            stopPx := math.max(stopPx, ta.highest(high, 10) - atr * trailATR)
        else
            stopPx := math.min(stopPx, ta.lowest(low, 10) + atr * trailATR)
    // Exit conditions
    hitSL = (inTradeDir == 1 and low <= stopPx) or (inTradeDir == -1 and high >= stopPx)
    hitTP2= (inTradeDir == 1 and high >= tp2Px) or (inTradeDir == -1 and low <= tp2Px)
    timeUp= barsInTrade >= maxBarsHold
    if hitSL or hitTP2 or timeUp
        reason = hitSL ? "SL" : hitTP2 ? "TP2" : "TIME"
        label.new(bar_index, close, reason, style=label.style_label_down,
                  color=color.new(color.gray, 30), textcolor=color.white, size=size.small)
        inTradeDir := 0, barsInTrade := 0, tp1Hit := false

// Plot live trade levels
plot(inTradeDir != 0 ? entryPx : na, "Live Entry", color=color.blue,  style=plot.style_linebr)
plot(inTradeDir != 0 ? stopPx  : na, "Live Stop",  color=color.red,   style=plot.style_linebr)
plot(inTradeDir != 0 ? tp1Px   : na, "Live TP1",   color=color.teal,  style=plot.style_linebr)
plot(inTradeDir != 0 ? tp2Px   : na, "Live TP2",   color=color.green, style=plot.style_linebr)
