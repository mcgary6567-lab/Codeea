<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/filter_item_size"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:layout_marginEnd="8dp">

    <FrameLayout
        android:layout_width="@dimen/filter_item_size"
        android:layout_height="@dimen/filter_item_size">

        <ImageView
            android:id="@+id/ivFilterPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/bg_elevated" />

        <View
            android:id="@+id/viewFilterSelected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_filter_selected"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvFilterName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Original"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/filter_item_label_size"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
