# Copy to `.env` (or set these in your host's environment panel). NEVER commit .env.

# REQUIRED — master key for encrypting customer API keys + signing logins.
# Generate once:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# If you ever change this, all stored API keys + logins become unreadable.
TREVOLTO_SECRET_KEY=change-me-to-a-long-random-string

# REQUIRED — the public URL of THIS app (your subdomain). Used to build each
# customer's TradingView webhook URL. Must be https for TradingView.
TREVOLTO_PUBLIC_URL=https://app.trevolto.com

# Where the SQLite database + master key file live. Pick a path OUTSIDE the
# web root so it's never served. Auto-created.
TREVOLTO_DATA_DIR=/home/youruser/trevolto-data

# Free-trial length (days) before a customer needs a licence.
TREVOLTO_TRIAL_DAYS=10

# Optional — this email becomes an admin automatically on signup.
# (Otherwise the FIRST account you register is the admin.)
TREVOLTO_ADMIN_EMAIL=you@youremail.com
