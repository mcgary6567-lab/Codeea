# Scripts that run inside Linux containers or on a VPS must keep LF endings even when checked out on
# Windows (Docker Desktop builds the image from the working tree). CRLF in a shebang line breaks them.
*.sh            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
deploy/Caddyfile text eol=lf
*.toml          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.ps1           text eol=crlf
