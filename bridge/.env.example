# ============================================================================
#  Dip2Green PRO -> Exchange bridge configuration
#  Copy this file to ".env" and fill it in. NEVER commit your real .env.
# ============================================================================

# ---- Webhook security -------------------------------------------------------
# Shared secret. TradingView must include this (URL ?token=... or "secret" in
# the JSON body). Requests without the correct value are rejected.
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# Port the bridge listens on.
PORT=8080

# ---- SAFETY SWITCHES (defaults are intentionally non-destructive) -----------
# DRY_RUN=true  -> log what WOULD happen, place NO real orders.
# Set to false ONLY after you've tested on testnet.
DRY_RUN=true

# TESTNET=true  -> use the exchange's sandbox/testnet, not real funds.
TESTNET=true

# ---- Exchange ---------------------------------------------------------------
# Any CCXT id: binance, binanceusdm, bybit, okx, kraken, kucoin, gateio,
# bitget, mexc, ...  (binanceusdm = Binance USDT-M Futures)
EXCHANGE=binance

API_KEY=
API_SECRET=
# Only some exchanges (okx, kucoin, bitget) need a passphrase:
API_PASSWORD=

# Market type for unified CCXT calls: spot | swap | future
MARKET_TYPE=spot

# ---- Risk / sizing ----------------------------------------------------------
# Risk per trade as a fraction of free quote balance (0.01 = 1%).
# Position size is derived from this and the entry->stop distance.
RISK_PCT=0.01

# Hard cap on notional per trade in quote currency (e.g. USDT). 0 = no cap.
MAX_NOTIONAL=0

# How to split the position across the two take-profits (must sum to 1.0).
TP1_FRACTION=0.5
TP2_FRACTION=0.5

# Entry order type: market | limit  (limit uses the alert's "entry" price)
ENTRY_TYPE=market

# Optional allow-list of symbols (comma separated, CCXT format e.g.
# BTC/USDT,ETH/USDT). Empty = allow any symbol the alert sends.
SYMBOL_WHITELIST=
