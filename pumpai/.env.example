# --- Server ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=https://your-domain.pk
# DB_PATH=./data/pumpai.db
# SCHEDULER=off            # disable background automations
TZ_NAME=Asia/Karachi

# --- Claude AI (optional: without it the built-in Roman Urdu rule engine is used) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low              # low | medium | high

# --- WhatsApp Cloud API (optional: without it messages are simulated) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pumpai-verify
WA_APP_SECRET=
WA_TEMPLATE_NAME=general_update   # approved utility template with one {{1}} body variable
WA_TEMPLATE_LANG=en
WA_TENANT_ID=1

# --- Payments ---
# the pump's own online payment page (bank / JazzCash merchant link); empty = no "pay online" line in messages
PAYMENT_LINK_BASE=

# Backups (default: data/backups next to the database)
# BACKUP_DIR=/mnt/cloud-sync/pumpai-backups
# Phone push alerts (optional; generated automatically if not set)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Installation (see INSTALL.md) ---
# DEMO_DATA=0               # 1 = demo pump in an empty database; 0 = setup wizard (default 0 when NODE_ENV=production)
# SETUP_TOKEN=AB12CD34      # code the setup wizard asks for
# SUPERVISED=1              # running under systemd / Docker: allows "Restart now" in Settings → Backups
# VENDOR_NAME=Your Company  # support details shown to the owner in Settings → About
# VENDOR_PHONE=
# VENDOR_EMAIL=
