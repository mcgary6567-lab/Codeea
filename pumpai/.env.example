# --- Server ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=https://your-domain.pk
# DB_PATH=./data/pumpai.db
# SCHEDULER=off            # disable background automations
TZ_NAME=Asia/Karachi

# --- Claude AI (optional: without it the built-in Roman Urdu rule engine is used) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low              # low | medium | high

# --- WhatsApp Cloud API (optional: without it messages are simulated) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pumpai-verify
WA_APP_SECRET=
WA_TEMPLATE_NAME=general_update   # approved utility template with one {{1}} body variable
WA_TEMPLATE_LANG=en
WA_TENANT_ID=1

# --- Payments ---
PAYMENT_LINK_BASE=https://pay.example.pk/pumpai
