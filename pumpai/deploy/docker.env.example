# Copy to ../.env and fill in, then: docker compose up -d
# The pump's address (point its DNS A record to this server first)
DOMAIN=pump.example.pk

# Leave these two empty: a strong secret is made and kept with the database, and the setup
# code is printed in the log on the first start (docker compose logs app | grep "SETUP CODE").
# If you set JWT_SECRET yourself, make it long: openssl rand -hex 32
JWT_SECRET=
SETUP_TOKEN=

DEMO_DATA=0
TZ_NAME=Asia/Karachi

# Optional — Claude AI (photo reading, Urdu chat). Without it the built-in rule engine is used.
ANTHROPIC_API_KEY=
# Optional — WhatsApp Cloud API (both secret and token are needed for live messages)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Optional — the pump's own online payment page; empty = no "pay online" line in messages
PAYMENT_LINK_BASE=
# Optional — copy every nightly backup off this server, e.g. rclone copy "$BACKUP_FILE" gdrive:pumpai
BACKUP_COPY_CMD=

# Who installed and supports this copy (shown in Help → About)
VENDOR_NAME=
VENDOR_PHONE=
VENDOR_EMAIL=
