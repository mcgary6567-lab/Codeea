//@version=6
indicator("Prometheus AI Crypto Bot", "Prometheus", overlay=true, max_labels_count=500, max_lines_count=500)

plot(na, "ghost", display=display.none)

// ============ TYPES ============
type SignalRec
    int   barIdx
    int   tstamp
    float entry
    float tp1
    float tp2
    int   status   // 0=open 1=win(TP2) 3=expired 4=partial(TP1)
    bool  tp1Hit
    bool  tp2Hit
    bool  isLong

// ============ EMA RIBBON ============
grpEma    = "EMA Ribbon"
emaLen1   = input.int(9,  "EMA Fast", minval=1, group=grpEma)
emaLen2   = input.int(21, "EMA Mid",  minval=1, group=grpEma)
emaLen3   = input.int(50, "EMA Slow", minval=1, group=grpEma)
emaSrc    = input.source(close, "Source", group=grpEma)
emaCD     = input.int(3, "Cooldown bars between signals", minval=0, group=grpEma, tooltip="Minimum bars between signals to avoid clustering.")

// ============ DIRECTION / TARGETS ============
grpDir    = "Direction & Targets"
allowLong = input.bool(true,  "Allow longs (BUY on bullish cross)", group=grpDir)
allowShort= input.bool(true, "Allow shorts (SELL on bearish cross) - futures only", group=grpDir, tooltip="ON = open a SHORT on a bearish cross (needs a futures account). OFF = long only; a bearish cross CLOSES the long (exit).")
useTP     = input.bool(true,  "Use TP1/TP2 targets", group=grpDir, tooltip="ON = send % take-profits like before (the opposite cross still closes as a backstop). OFF = exit only on the opposite cross.")
tp1Pct    = input.float(1.0, "TP1 %", minval=0.1, step=0.1, group=grpDir)
tp2Pct    = input.float(2.0, "TP2 %", minval=0.1, step=0.1, group=grpDir)

// ============ VISUALS ============
grpVis     = "Visuals"
showRibbon = input.bool(true, "Show EMA ribbon", group=grpVis)
showLevels = input.bool(true, "Draw Entry / TP levels", group=grpVis)
showLabels = input.bool(true, "Show BUY / SELL labels", group=grpVis)

// ============ DASHBOARD ============
grpDash     = "Dashboard"
showDash    = input.bool(true, "Show Dashboard", group=grpDash)
dashPos     = input.string("Top Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group=grpDash)
dashRows    = input.int(5,   "Max Rows",               minval=3, maxval=15, group=grpDash)
dashFilter  = input.string("Wins + Open", "Show in Table", options=["Wins + Open","Wins Only"], group=grpDash)
trackWindow = input.int(120, "Tracking Window (bars)", minval=20, group=grpDash)

// ============ ALERTS ============
grpAlert    = "Alerts"
alertOnBar  = input.string("Bar Close", "Alert Mode",   options=["Bar Close","Every Tick"], tooltip="'Bar Close' = confirmed candles only (no repaint).", group=grpAlert)
alertHeader = input.string("Prometheus AI Crypto Bot", "Alert Header", group=grpAlert)
alertFmt    = input.string("Webhook JSON",  "Alert Format", options=["Telegram","Readable","Compact","Webhook JSON"], group=grpAlert)
alertOnTP   = input.bool(true, "Alert on TP Hit", group=grpAlert)

// ============ TELEGRAM ============
grpTg    = "Telegram"
tgChatId = input.string("", "Telegram Chat ID", group=grpTg)

// ============ BOT / WEBHOOK ============
grpBot      = "Bot / Webhook"
strategyTag = input.string("Prometheus", "Strategy tag", group=grpBot, tooltip="Sent as 'comment' - set the bot's Strategy filter to the same value.")
whSecret    = input.string("",           "Webhook passphrase", group=grpBot, tooltip="Must match the bot's Webhook passphrase. Leave blank if the bot has none.")

// ============ HELPERS ============
f_px(x) => str.tostring(x, format.mintick)
f_pct(target, base) => str.tostring((target - base) / base * 100.0, "#.##")

posMap(s) =>
    var r = position.top_right
    if s == "Top Left"
        r := position.top_left
    else if s == "Bottom Right"
        r := position.bottom_right
    else if s == "Bottom Left"
        r := position.bottom_left
    else if s == "Middle Right"
        r := position.middle_right
    r

statusText(st) =>
    var t = ""
    if st == 0
        t := "OPEN"
    else if st == 1
        t := "WIN"
    else if st == 3
        t := "EXP"
    else if st == 4
        t := "PART"
    t

statusBg(st) =>
    var c = color.new(color.gray, 80)
    if st == 0
        c := color.new(color.yellow, 80)
    else if st == 1
        c := color.new(color.green, 80)
    else if st == 4
        c := color.new(color.orange, 80)
    c

passesFilter(st, f) =>
    var ok = false
    if f == "Wins + Open"
        ok := st == 0 or st == 1 or st == 4
    else
        ok := st == 1 or st == 4
    ok

// ============ CALCS ============
tickerStr = syminfo.ticker
atr  = ta.atr(14)
ema1 = ta.ema(emaSrc, emaLen1)
ema2 = ta.ema(emaSrc, emaLen2)
ema3 = ta.ema(emaSrc, emaLen3)

// A SIGNAL fires when the FAST EMA actually crosses the SLOW EMA — i.e. the
// fast cuts through the whole ribbon (a real regime change). This avoids the
// noise from price wandering across the ribbon, and from the fast/mid EMAs
// wiggling against each other while the slow EMA is flat and far away.
buyRaw  = ta.crossover(ema1, ema3)    // fast (9) crosses ABOVE slow (50)
sellRaw = ta.crossunder(ema1, ema3)   // fast (9) crosses BELOW slow (50)

// ============ SIGNAL STATE ============
var int lastSig = -1000
ready   = barstate.isconfirmed and (bar_index - lastSig) >= emaCD
buySig  = ready and buyRaw  and allowLong
sellSig = ready and sellRaw and (allowShort or allowLong)   // long-only -> sell = exit
if buySig or sellSig
    lastSig := bar_index

// ============ ENTRY / TARGETS ============
entry   = close
tp1Long = entry * (1.0 + tp1Pct / 100.0)
tp2Long = entry * (1.0 + tp2Pct / 100.0)
tp1Sh   = entry * (1.0 - tp1Pct / 100.0)
tp2Sh   = entry * (1.0 - tp2Pct / 100.0)
entryS  = f_px(entry)

freq    = alertOnBar == "Bar Close" ? alert.freq_once_per_bar_close : alert.freq_once_per_bar
timeStr = str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone)

// ============ SIGNAL TRACKING ============
var array<SignalRec> signals = array.new<SignalRec>()
TRACK_MAX = 50

// Track long entries (and short entries when shorts are enabled).
if buySig
    array.unshift(signals, SignalRec.new(bar_index, time, entry, tp1Long, tp2Long, 0, false, false, true))
    while array.size(signals) > TRACK_MAX
        array.pop(signals)
if sellSig and allowShort
    array.unshift(signals, SignalRec.new(bar_index, time, entry, tp1Sh, tp2Sh, 0, false, false, false))
    while array.size(signals) > TRACK_MAX
        array.pop(signals)

if array.size(signals) > 0
    for i = 0 to array.size(signals) - 1
        rec = array.get(signals, i)
        if rec.status == 0
            barsIn = bar_index - rec.barIdx
            if barsIn > 0
                hitTP2 = rec.isLong ? high >= rec.tp2 : low <= rec.tp2
                hitTP1 = rec.isLong ? high >= rec.tp1 : low <= rec.tp1

                tpEvent    = ""
                tpPriceHit = 0.0
                if hitTP2 and not rec.tp2Hit
                    rec.tp2Hit := true
                    rec.tp1Hit := true
                    tpEvent    := "tp2_hit"
                    tpPriceHit := rec.tp2
                else if hitTP1 and not rec.tp1Hit
                    rec.tp1Hit := true
                    tpEvent    := "tp1_hit"
                    tpPriceHit := rec.tp1

                if rec.tp2Hit
                    rec.status := 1
                else if barsIn >= trackWindow
                    rec.status := rec.tp1Hit ? 4 : 3

                array.set(signals, i, rec)

                if alertOnTP and tpEvent != ""
                    tpNum = tpEvent == "tp1_hit" ? "TP1" : "TP2"
                    pStr  = f_px(tpPriceHit)
                    eStr  = f_px(rec.entry)
                    gStr  = f_pct(tpPriceHit, rec.entry)
                    cpTP  = tickerStr + " " + tpNum + " HIT @ " + pStr + " | Entry " + eStr + " | " + gStr + "%"
                    jsTP  = '{"event":"' + tpEvent + '","symbol":"' + tickerStr +
                             '","passphrase":"' + whSecret + '","price":' + pStr + ',"entry":' + eStr +
                             ',"tp1":' + f_px(rec.tp1) + ',"tp2":' + f_px(rec.tp2) +
                             ',"comment":"' + strategyTag + '","strategy":"ema","tf":"' + timeframe.period +
                             '","time":"' + timeStr + '"}'
                    rdTP  = alertHeader + " - " + tickerStr + "\n" + tpNum + " HIT: " + pStr + " (" + gStr + "%)\nEntry: " + eStr + "\n" + timeStr
                    tgTP  = '{"chat_id":"' + tgChatId + '","text":"' + str.replace_all(rdTP, "\n", "\\n") + '","parse_mode":"HTML","disable_web_page_preview":true}'
                    tpMsg = alertFmt == "Telegram" ? tgTP : alertFmt == "Webhook JSON" ? jsTP : alertFmt == "Compact" ? cpTP : rdTP
                    alert(tpMsg, freq)

// ============ ENTRY / EXIT ALERTS ============
// BUY (long)
buyTPjson = useTP ? (',"tp1":' + f_px(tp1Long) + ',"tp2":' + f_px(tp2Long)) : ''
jBuy = '{"action":"buy","symbol":"' + tickerStr + '","passphrase":"' + whSecret +
       '","entry":' + entryS + buyTPjson +
       ',"comment":"' + strategyTag + '","strategy":"ema","tf":"' + timeframe.period + '","time":"' + timeStr + '"}'

// SELL: short entry (futures) OR exit/close the long (default)
sellTPjson = useTP ? (',"tp1":' + f_px(tp1Sh) + ',"tp2":' + f_px(tp2Sh)) : ''
jShort = '{"action":"sell","symbol":"' + tickerStr + '","passphrase":"' + whSecret +
         '","entry":' + entryS + sellTPjson +
         ',"comment":"' + strategyTag + '","strategy":"ema","tf":"' + timeframe.period + '","time":"' + timeStr + '"}'
jExit  = '{"event":"exit","symbol":"' + tickerStr + '","passphrase":"' + whSecret +
         '","comment":"' + strategyTag + '","strategy":"ema","tf":"' + timeframe.period + '","time":"' + timeStr + '"}'
jSell  = allowShort ? jShort : jExit

buyTxt  = alertHeader + " - " + tickerStr + " (" + timeframe.period + ")\nEMA BUY @ " + entryS +
          (useTP ? "\nTP1 " + f_px(tp1Long) + " | TP2 " + f_px(tp2Long) : "") + "\n" + timeStr
sellTxt = alertHeader + " - " + tickerStr + " (" + timeframe.period + ")\n" +
          (allowShort ? "EMA SELL/SHORT @ " : "EMA EXIT (close long) @ ") + entryS + "\n" + timeStr
tgBuy  = '{"chat_id":"' + tgChatId + '","text":"' + str.replace_all(buyTxt,  "\n", "\\n") + '","parse_mode":"HTML","disable_web_page_preview":true}'
tgSell = '{"chat_id":"' + tgChatId + '","text":"' + str.replace_all(sellTxt, "\n", "\\n") + '","parse_mode":"HTML","disable_web_page_preview":true}'

buyMsg  = alertFmt == "Webhook JSON" ? jBuy  : alertFmt == "Telegram" ? tgBuy  : alertFmt == "Compact" ? (tickerStr + " EMA BUY @ " + entryS) : buyTxt
sellMsg = alertFmt == "Webhook JSON" ? jSell : alertFmt == "Telegram" ? tgSell : alertFmt == "Compact" ? (tickerStr + (allowShort ? " EMA SELL @ " : " EMA EXIT @ ") + entryS) : sellTxt

if buySig
    alert(buyMsg, freq)
if sellSig
    alert(sellMsg, freq)

alertcondition(buySig,  title="Prometheus EMA BUY",  message="Prometheus EMA Ribbon - BUY")
alertcondition(sellSig, title="Prometheus EMA SELL", message="Prometheus EMA Ribbon - SELL/EXIT")

// ============ VISUALS ============
plot(showRibbon ? ema1 : na, "EMA Fast", color=color.new(#26c281, 0), linewidth=1)
plot(showRibbon ? ema2 : na, "EMA Mid",  color=color.new(#f0883e, 0), linewidth=1)
plot(showRibbon ? ema3 : na, "EMA Slow", color=color.new(#8e7cff, 0), linewidth=2)

plotshape(buySig,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="BUY",  textcolor=color.white, force_overlay=true)
plotshape(sellSig, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),   size=size.small, text="SELL", textcolor=color.white, force_overlay=true)
bgcolor(buySig ? color.new(color.green, 85) : sellSig ? color.new(color.red, 85) : na, title="Signal BG")

// ---- Entry / TP level lines + labels ----
tp1str = str.tostring(tp1Pct, "#.##")
tp2str = str.tostring(tp2Pct, "#.##")
var line  enLine  = na
var line  tp1Line = na
var line  tp2Line = na
var label enLbl   = na
var label tp1Lbl  = na
var label tp2Lbl  = na
var label sigLbl  = na

drawLong  = showLevels and buySig
drawShort = showLevels and sellSig and allowShort
if drawLong or drawShort
    t1  = drawLong ? tp1Long : tp1Sh
    t2  = drawLong ? tp2Long : tp2Sh
    sgn = drawLong ? "+" : "-"
    line.delete(enLine), line.delete(tp1Line), line.delete(tp2Line)
    label.delete(enLbl), label.delete(tp1Lbl), label.delete(tp2Lbl)
    enLine  := line.new(bar_index, entry, bar_index + 30, entry, color=color.blue,   width=2, style=line.style_solid,  force_overlay=true)
    tp1Line := line.new(bar_index, t1,    bar_index + 30, t1,    color=color.orange, width=1, style=line.style_dashed, force_overlay=true)
    tp2Line := line.new(bar_index, t2,    bar_index + 30, t2,    color=color.aqua,   width=2, style=line.style_dashed, force_overlay=true)
    enLbl   := label.new(bar_index + 30, entry, "ENTRY " + f_px(entry),                              color=color.new(color.blue,   0), textcolor=color.white, style=label.style_label_left, size=size.small, force_overlay=true)
    tp1Lbl  := label.new(bar_index + 30, t1,    "TP1 " + f_px(t1) + " (" + sgn + tp1str + "%)",      color=color.new(color.orange, 0), textcolor=color.white, style=label.style_label_left, size=size.small, force_overlay=true)
    tp2Lbl  := label.new(bar_index + 30, t2,    "TP2 " + f_px(t2) + " (" + sgn + tp2str + "%)",      color=color.new(color.aqua,   0), textcolor=color.white, style=label.style_label_left, size=size.small, force_overlay=true)

// On a long-only EXIT (close), clear the previous long's Entry/TP lines so they
// don't linger above the exit and look like the sell's targets.
if showLevels and sellSig and not allowShort
    line.delete(enLine), line.delete(tp1Line), line.delete(tp2Line)
    label.delete(enLbl), label.delete(tp1Lbl), label.delete(tp2Lbl)
    curDone := true

if showLabels and buySig
    label.delete(sigLbl)
    sigLbl := label.new(bar_index, low - atr, "BUY @ " + entryS, color=color.new(color.lime, 0), textcolor=color.black, style=label.style_label_up, size=size.normal, textalign=text.align_center, force_overlay=true)
if showLabels and sellSig
    label.delete(sigLbl)
    sellWord = allowShort ? "SELL @ " : "EXIT @ "
    sigLbl := label.new(bar_index, high + atr, sellWord + entryS, color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=size.normal, textalign=text.align_center, force_overlay=true)

// ============ DASHBOARD ============
var table dash = na

if showDash and barstate.islast
    if not na(dash)
        table.delete(dash)

    displayList = array.new<SignalRec>()
    if array.size(signals) > 0
        for i = 0 to array.size(signals) - 1
            rec = array.get(signals, i)
            if passesFilter(rec.status, dashFilter) and array.size(displayList) < dashRows
                array.push(displayList, rec)

    nRows     = array.size(displayList)
    totalRows = 2 + math.max(nRows, 1)
    filterLabel = dashFilter == "Wins + Open" ? "Active & Wins" : "Win Signals"
    tfStr       = timeframe.isminutes ? timeframe.period + "M" : timeframe.isseconds ? timeframe.period + "S" : timeframe.period
    titleTxt    = "Prometheus EMA - " + filterLabel + " | " + tickerStr + " " + tfStr

    dash := table.new(posMap(dashPos), 5, totalRows, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 60), frame_width=1, frame_color=color.new(color.gray, 30))

    table.cell(dash, 0, 0, titleTxt, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, text_halign=text.align_left)
    table.merge_cells(dash, 0, 0, 4, 0)

    hBg = color.new(color.gray, 40)
    table.cell(dash, 0, 1, "Time",   text_color=color.white,                bgcolor=hBg, text_size=size.small)
    table.cell(dash, 1, 1, "Entry",  text_color=color.white,                bgcolor=hBg, text_size=size.small)
    table.cell(dash, 2, 1, "TP1",    text_color=color.new(color.orange, 0), bgcolor=hBg, text_size=size.small)
    table.cell(dash, 3, 1, "TP2",    text_color=color.new(color.aqua,   0), bgcolor=hBg, text_size=size.small)
    table.cell(dash, 4, 1, "Status", text_color=color.white,                bgcolor=hBg, text_size=size.small)

    if nRows > 0
        for i = 0 to nRows - 1
            rec    = array.get(displayList, i)
            rowIdx = 2 + i
            rowBg  = statusBg(rec.status)
            sTxt   = statusText(rec.status) + (rec.isLong ? " L" : " S")
            tStr   = str.format_time(rec.tstamp, "HH:mm:ss", syminfo.timezone)
            tp1Bg  = rec.tp1Hit ? color.new(color.orange, 50) : rowBg
            tp2Bg  = rec.tp2Hit ? color.new(color.aqua,   50) : rowBg
            tp1Txt = rec.tp1Hit ? "HIT" : f_px(rec.tp1)
            tp2Txt = rec.tp2Hit ? "HIT" : f_px(rec.tp2)
            table.cell(dash, 0, rowIdx, tStr,            bgcolor=rowBg, text_color=color.white, text_size=size.small)
            table.cell(dash, 1, rowIdx, f_px(rec.entry), bgcolor=rowBg, text_color=color.white, text_size=size.small)
            table.cell(dash, 2, rowIdx, tp1Txt,          bgcolor=tp1Bg, text_color=color.white, text_size=size.small)
            table.cell(dash, 3, rowIdx, tp2Txt,          bgcolor=tp2Bg, text_color=color.white, text_size=size.small)
            table.cell(dash, 4, rowIdx, sTxt,            bgcolor=rowBg, text_color=color.white, text_size=size.small)
    else
        table.cell(dash, 0, 2, "No " + filterLabel + " yet - waiting...", text_color=color.new(color.white, 40), bgcolor=color.new(color.gray, 90), text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 0, 2, 4, 2)
