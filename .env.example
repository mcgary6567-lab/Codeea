# Copy to .env and adjust. SQLite is used by default for localhost.
APP_NAME="Online Quran College OS"
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/oqc.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://oqc:password@localhost:5432/oqc
HOST=127.0.0.1
PORT=8000
BASE_URL=http://127.0.0.1:8000
SESSION_HOURS=12
ACCESS_TOKEN_MINUTES=720
BASE_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi
# Video: jitsi (browser WebRTC, no signup) | daily | custom
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
# Integrations (leave blank to run in simulation mode)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
GHL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@onlinequrancollege.local
AI_PROVIDER=simulated
AI_API_KEY=
